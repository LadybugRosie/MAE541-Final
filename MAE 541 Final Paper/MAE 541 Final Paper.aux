\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Oja Learning Does Not Self-Organize to the Edge of Chaos}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Spectral radius $\rho (W(t))$ over time for all initial conditions $g_0$ under sinusoidal drive (top) and autonomous dynamics (bottom). Under drive, $\rho (W)\to 45$ regardless of $g_0$. Without drive, a clean bifurcation at $g_0 = 1$ is visible.}}{7}{}\protected@file@percent }
\newlabel{fig:rho_traj}{{5.1}{7}{}{figure.5.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Edge-of-Chaos Optimality for Signal Reconstruction}{7}{}\protected@file@percent }
\citation{sompolinsky1988chaos}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Signal reconstruction $R^2$ as a function of initial spectral radius $g_0$. The peak near $g_0 \approx 0.9$--$1.0$ reflects the richest transient activity at the edge of chaos. Mean $\pm $ one standard deviation across 5 seeds.}}{8}{}\protected@file@percent }
\newlabel{fig:r2_vs_g}{{5.2}{8}{}{figure.5.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Frozen Random Reservoir Outperforms Oja-Learned Weights}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Comparison of signal reconstruction $R^2$ for Oja-learned weights (solid) versus a frozen random reservoir with ridge regression (dashed). The frozen reservoir achieves $R^2 \approx 1.0$ for all $g_0$; Oja learning is consistently worse.}}{9}{}\protected@file@percent }
\newlabel{fig:r2_comparison}{{5.3}{9}{}{figure.5.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Input Structure Drives Rank Collapse}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Rank of the rolling activity correlation matrix $\hat  {C}$ over time for sinusoidal drive (left) and white noise drive (right), at $g = 1.0$. Sinusoidal drive collapses the rank to 1 within $T \approx 50$; white noise preserves full rank.}}{10}{}\protected@file@percent }
\newlabel{fig:rank_collapse}{{5.4}{10}{}{figure.5.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Effective Gain Is Self-Regulated by Saturation}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Time-averaged effective gain $g_{\mathrm  {eff}}$ (blue circles) and direct $\rho (D(t)W)$ (orange squares) versus nominal $g$ for frozen weights under sinusoidal drive. The dotted diagonal shows the no-saturation baseline $g_{\mathrm  {eff}} = g$. The heuristic tracks $\rho (DW)$ within 5\% across all $g$. The $g_{\mathrm  {eff}} = 1$ stability crossing occurs at $g \approx 1.5$, shifted right of the Girko prediction $g=1$.}}{11}{}\protected@file@percent }
\newlabel{fig:geff_scan}{{5.5}{11}{}{figure.5.5}{}}
